{
  "name": "@mihaicristiancondrea/workshop-expressive-web-components",
  "private": false,
  "version": "0.3.2",
  "description": "Workshop Expressive design-system web components built with Lit.",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "node scripts/clean.cjs dist && tsc && node scripts/copy-foundation.cjs",
    "build:watch": "tsc --watch",
    "clean": "node scripts/clean.cjs dist custom-elements.json docs ws-button.bundled.js index.d.ts index.d.ts.map index.js index.js.map docs-entry.d.ts docs-entry.d.ts.map docs-entry.js docs-entry.js.map components foundation test",
    "lint": "npm run lint:lit-analyzer && npm run lint:eslint",
    "lint:eslint": "eslint \"src/**/*.ts\"",
    "lint:lit-analyzer": "lit-analyzer",
    "format": "prettier \"**/*.{cjs,html,js,json,md,ts,yml}\" --ignore-path ./.eslintignore --write",
    "docs": "npm run docs:clean && npm run build && npm run analyze && npm run docs:build && npm run docs:assets && npm run docs:gen",
    "docs:clean": "node scripts/clean.cjs docs",
    "docs:gen": "eleventy --config=.eleventy.cjs",
    "docs:gen:watch": "eleventy --config=.eleventy.cjs --watch",
    "docs:build": "rollup -c --file docs/ws-button.bundled.js",
    "docs:assets": "node scripts/copy-docs-assets.cjs",
    "docs:serve": "wds --root-dir=docs --node-resolve --watch",
    "analyze": "cem analyze --litelement --globs \"src/**/*.ts\"",
    "analyze:watch": "cem analyze --litelement --globs \"src/**/*.ts\" --watch",
    "serve": "wds --watch",
    "serve:prod": "MODE=prod npm run serve",
    "test": "npm run test:dev && npm run test:prod",
    "test:dev": "node scripts/run-wtr.cjs dev",
    "test:watch": "wtr --watch",
    "test:prod": "node scripts/run-wtr.cjs prod",
    "test:prod:watch": "MODE=prod wtr --watch",
    "checksize": "rollup -c ; cat ws-button.bundled.js | gzip -9 | wc -c ; rm ws-button.bundled.js",
    "docs:verify": "node scripts/verify-docs-structure.cjs",
    "pack:check": "npm pack --dry-run",
    "security:audit": "npm audit",
    "ci": "npm run security:audit && npm run lint && npm run build && npm test && npm run docs && npm run docs:verify && npm run pack:check"
  },
  "keywords": [
    "web-components",
    "lit-element",
    "typescript",
    "lit"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Atlas-Tutoring/workshop-expressive-web-components.git"
  },
  "bugs": {
    "url": "https://github.com/Atlas-Tutoring/workshop-expressive-web-components/issues"
  },
  "homepage": "https://github.com/Atlas-Tutoring/workshop-expressive-web-components#readme",
  "author": "Google LLC",
  "license": "BSD-3-Clause",
  "dependencies": {
    "lit": "^3.2.0",
    "remixicon": "^4.9.1"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-plugin-syntaxhighlight": "^4.0.0",
    "@custom-elements-manifest/analyzer": "^0.6.3",
    "@open-wc/testing": "^4.0.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-replace": "^5.0.7",
    "@rollup/plugin-terser": "^1.0.0",
    "@typescript-eslint/eslint-plugin": "^5.25.0",
    "@typescript-eslint/parser": "^5.25.0",
    "@web/dev-server": "^0.4.6",
    "@web/test-runner": "^1.0.0",
    "@webcomponents/webcomponentsjs": "^2.8.0",
    "eslint": "^8.15.0",
    "lit-analyzer": "^2.0.3",
    "prettier": "^2.6.2",
    "rollup": "^4.18.0",
    "rollup-plugin-summary": "^2.0.1",
    "typescript": "~5.9.0"
  },
  "overrides": {
    "js-yaml@^3.0.0": "3.15.2",
    "js-yaml@^4.0.0": "4.3.2",
    "brace-expansion": "1.1.18",
    "liquidjs": "10.29.0",
    "nanoid": "3.3.18"
  },
  "engines": {
    "node": ">=24"
  },
  "types": "dist/index.d.ts",
  "customElements": "custom-elements.json",
  "files": [
    "dist",
    "!dist/test",
    "custom-elements.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./app-bar": {
      "types": "./dist/components/app-bar/index.d.ts",
      "import": "./dist/components/app-bar/index.js"
    },
    "./badge": {
      "types": "./dist/components/badge/index.d.ts",
      "import": "./dist/components/badge/index.js"
    },
    "./brand": {
      "types": "./dist/components/brand/index.d.ts",
      "import": "./dist/components/brand/index.js"
    },
    "./breadcrumbs": {
      "types": "./dist/components/breadcrumbs/index.d.ts",
      "import": "./dist/components/breadcrumbs/index.js"
    },
    "./button": {
      "types": "./dist/components/button/index.d.ts",
      "import": "./dist/components/button/index.js"
    },
    "./card": {
      "types": "./dist/components/card/index.d.ts",
      "import": "./dist/components/card/index.js"
    },
    "./checkbox": {
      "types": "./dist/components/checkbox/index.d.ts",
      "import": "./dist/components/checkbox/index.js"
    },
    "./chip": {
      "types": "./dist/components/chip/index.d.ts",
      "import": "./dist/components/chip/index.js"
    },
    "./code-block": {
      "types": "./dist/components/code-block/index.d.ts",
      "import": "./dist/components/code-block/index.js"
    },
    "./color-picker": {
      "types": "./dist/components/color-picker/index.d.ts",
      "import": "./dist/components/color-picker/index.js"
    },
    "./date-picker": {
      "types": "./dist/components/date-picker/index.d.ts",
      "import": "./dist/components/date-picker/index.js"
    },
    "./dialog": {
      "types": "./dist/components/dialog/index.d.ts",
      "import": "./dist/components/dialog/index.js"
    },
    "./docs-shell": {
      "types": "./dist/components/docs-shell/index.d.ts",
      "import": "./dist/components/docs-shell/index.js"
    },
    "./drawer": {
      "types": "./dist/components/drawer/index.d.ts",
      "import": "./dist/components/drawer/index.js"
    },
    "./dropdown": {
      "types": "./dist/components/dropdown/index.d.ts",
      "import": "./dist/components/dropdown/index.js"
    },
    "./page": {
      "types": "./dist/components/page/index.d.ts",
      "import": "./dist/components/page/index.js"
    },
    "./switch": {
      "types": "./dist/components/switch/index.d.ts",
      "import": "./dist/components/switch/index.js"
    },
    "./tabs": {
      "types": "./dist/components/tabs/index.d.ts",
      "import": "./dist/components/tabs/index.js"
    },
    "./text-field": {
      "types": "./dist/components/text-field/index.d.ts",
      "import": "./dist/components/text-field/index.js"
    },
    "./time-picker": {
      "types": "./dist/components/time-picker/index.d.ts",
      "import": "./dist/components/time-picker/index.js"
    },
    "./foundation/theme.css": "./dist/foundation/theme.css",
    "./foundation/colors.css": "./dist/foundation/colors.css",
    "./foundation/schemes.css": "./dist/foundation/schemes.css",
    "./foundation/spacing.css": "./dist/foundation/spacing.css",
    "./foundation/shapes.css": "./dist/foundation/shapes.css",
    "./foundation/typography.css": "./dist/foundation/typography.css",
    "./foundation/motion.css": "./dist/foundation/motion.css",
    "./foundation/elevation.css": "./dist/foundation/elevation.css"
  },
  "sideEffects": [
    "dist/foundation/*.css",
    "dist/components/**/*.js",
    "dist/index.js"
  ]
}
